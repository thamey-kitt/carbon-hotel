# Supabase (fill in from your project's Settings > API page)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Typhoon OCR (https://opentyphoon.ai)
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-ocr-preview

# OpenRouter -- used for (1) the structured-extraction stage of OCR
# (turning Typhoon's markdown transcription into JSON fields) and
# (2) the chatbot, added later.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
